[Unit]
Description=The gunicorn WSGI server
After=network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/message_app

ExecStart=/home/ec2-user/message_app/venv/bin/gunicorn -c /home/ec2-user/message_app/gunicorn_conf.py app:app

Restart=always

Type=simple

[Install]
WantedBy=multi-user.target
