#Individual configuration for message_app

server {
    listen      443;
    server_name encouraging-messageapp.click;

    charset     utf-8;

    #ssl_certificate    /etc/pki/tls/certs/message_app.crt;
    #ssl_certificate_key        /etc/pki/tls/private/message_app.key;
    #ssl_password_file  /etc/pki/tls/private/message_app_key.passphrase;

    #処理は全てgunicorn側に渡す
    location / {
        proxy_pass http://127.0.0.1:8000;

        #受信したHostヘッダを、そのままGunicornへ渡す
        proxy_set_header Host $host;

        #元のアクセス元IPを渡す
        proxy_set_header X-Real-IP $remote_addr;

        #経由したIPを履歴として残す
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    #location / {
    #    root   /home/ec2-user/message_app/templates;
    #    index  index.html index.htm;
    #}

    error_page  404              /404.html;
    location = /404.html {
        root html;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   html;
    }

